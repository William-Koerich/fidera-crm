# Copy to .env.local and fill in. Never commit real values.

# Channel provider: mock | meta. "mock" works without a Meta account.
WHATSAPP_PROVIDER=mock

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Postgres connection used by migrations and DB tests (server/dev only).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?sslmode=require

# Webhook signature secret used by the mock provider (any random string locally).
MOCK_WEBHOOK_SECRET=dev-mock-secret
# Optional: Supabase CA (PEM) for full TLS verification of DATABASE_URL
DATABASE_CA_CERT=

# Public URL used in email links and invites (optional locally).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta webhook verification token (any random string you also set in the Meta app).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret: validates X-Hub-Signature-256 when WHATSAPP_PROVIDER=meta.
META_APP_SECRET=
# Protects /api/internal/* (pg_cron sweep and Vercel Cron send "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- Meta direct (WHATSAPP_PROVIDER=meta, e.g. the free Meta test number) ---
META_GRAPH_API_VERSION=v23.0
# Access token: temporary for the test number, system user token for a real number.
META_WHATSAPP_TOKEN=
# Number on Cloud API: a real number, or the free test number (WhatsApp -> API Setup).
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_DISPLAY_PHONE=

# --- ChatPro (WHATSAPP_PROVIDER=chatpro): number connected by QR Code ---
# Panel: https://painel.chatpro.com.br. Two keys, not interchangeable. Server only.
CHATPRO_INSTANCE_ID=
# Connection key: status, QR Code and disconnect, on CHATPRO_API_URL.
CHATPRO_TOKEN=
# ChatPro Chat key (instance-token): sending messages.
CHATPRO_CHAT_TOKEN=
# Connection host ChatPro gives for the instance. Default: https://oci.chatpro.com.br
CHATPRO_API_URL=
# Random secret that protects the webhook address: openssl rand -hex 32
CHATPRO_WEBHOOK_SECRET=
# The business that owns this instance (shown in Ajustes -> Canais).
CHATPRO_ORGANIZATION_ID=
# ChatPro account login: lets the CRM configure the webhook by itself. Server only.
CHATPRO_PANEL_EMAIL=
CHATPRO_PANEL_PASSWORD=

# --- AI assistant (optional): suggest a reply, improve a draft, summarize a conversation ---
# Off while empty. Each use is a paid Claude API call, estimated at a few US cents (check your bill), capped per business per hour.
# Conversation text goes to Anthropic to answer: mention it in your privacy policy. Server only.
ANTHROPIC_API_KEY=

# --- Website chat (optional) ---
# Signs visitor ids so nobody reads another visitor's chat. The chat is off while empty.
# Generate with: openssl rand -hex 32. Server only.
WEBCHAT_SECRET=
