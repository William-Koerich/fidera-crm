# Copy to .env.local and fill in. Never commit real values.

# Channel provider: mock | meta. "mock" works without a Meta account.
WHATSAPP_PROVIDER=mock

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Postgres connection used by migrations and DB tests (server/dev only).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?sslmode=require

# Webhook signature secret used by the mock provider (any random string locally).
MOCK_WEBHOOK_SECRET=dev-mock-secret
# Optional: Supabase CA (PEM) for full TLS verification of DATABASE_URL
DATABASE_CA_CERT=

# Public URL used in email links and invites (optional locally).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta webhook verification token (any random string you also set in the Meta app).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret: validates X-Hub-Signature-256 when WHATSAPP_PROVIDER=meta.
META_APP_SECRET=
# Protects /api/internal/* (pg_cron sweep and Vercel Cron send "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- Meta direct (WHATSAPP_PROVIDER=meta, e.g. the free Meta test number) ---
META_GRAPH_API_VERSION=v23.0
# Access token: temporary for the test number, system user token for a real number.
META_WHATSAPP_TOKEN=
# Number on Cloud API: a real number, or the free test number (WhatsApp -> API Setup).
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_DISPLAY_PHONE=

# --- ChatPro (WHATSAPP_PROVIDER=chatpro): number connected by QR Code ---
# Panel: https://painel.chatpro.com.br (instance code and its API token). Server only.
CHATPRO_INSTANCE_ID=
CHATPRO_TOKEN=
# Random secret that protects the webhook address: openssl rand -hex 32
CHATPRO_WEBHOOK_SECRET=
# The business that owns this instance (shown in Ajustes -> Canais).
CHATPRO_ORGANIZATION_ID=
